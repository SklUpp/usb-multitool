<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Count pill beside the Layout section title. -->
    <string name="partitions_count_badge">%1$d</string>
    <plurals name="partitions_count_a11y">
        <item quantity="one">%1$d partition</item>
        <item quantity="other">%1$d partitions</item>
    </plurals>
    <!-- Geometry lines under Layout: size and block/LBA counts only. -->
    <string name="partitions_geometry_size_label">Size</string>
    <string name="partitions_geometry_blocks_label">Blocks / LBA</string>
    <string name="partitions_geometry_blocks_value">%1$s</string>
    <!-- Scheme capsule arrow (text, not an icon). -->
    <string name="partitions_scheme_arrow">→</string>
    <!-- Localized EFI badge text (same glyph in every locale). -->
    <string name="partitions_badge_efi">EFI</string>
    <!-- Critical boot-role badge shared by Files and Partitions lists. -->
    <string name="partitions_badge_boot">BOOT</string>
    <!-- Exact overlapping partition pairs shown under the strip. -->
    <string name="partitions_overlap_heading">Partition overlaps</string>
    <string name="partitions_overlap_line">%1$s / %2$s: %3$d sectors</string>
