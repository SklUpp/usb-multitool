+/**@brief   Get size of a directory entry's inode without resolving its path.
+ *
+ * @param   dir   Directory handle used for the iteration.
+ * @param   inode Inode number from ext4_direntry.
+ * @param   size  Receives the inode size on success.
+ *
+ * @return  Standard error code.*/
+int ext4_dir_entry_get_size(ext4_dir *dir, uint32_t inode, uint64_t *size);
