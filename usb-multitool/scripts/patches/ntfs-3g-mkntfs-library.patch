+#ifdef MKNTFS_LIBRARY
+/*
+ * Format a caller-supplied ntfs_device (e.g. USB block callbacks) without a
+ * path, root, FUSE or mount table. Takes ownership of @dev: mkntfs_cleanup()
+ * frees it on every return path. @quick skips the full-volume zero fill.
+ * Returns 0 on success, otherwise -errno.
+ */
+int mkntfs_format_device(struct ntfs_device *dev, const char *label, int quick)
+{
+	int result;
+
+	if (!dev) {
+		errno = EINVAL;
+		return -EINVAL;
+	}
+
+	errno = 0;
+	mkntfs_init_options(&opts);
+	opts.dev_name = (char *)"usb_block";
+	opts.quick_format = quick ? TRUE : FALSE;
+	opts.force = TRUE;
+	opts.label = (char *)label;
+	opts.no_action = FALSE;
+
+	g_injected_device = dev;
+	result = mkntfs_redirect(&opts);
+	if (g_injected_device) {
+		/* Rejected before mkntfs took ownership. */
+		ntfs_device_free(g_injected_device);
+		g_injected_device = NULL;
+	}
+	if (result == 0)
+		return 0;
+	return -(errno ? errno : EIO);
+}
+#endif
